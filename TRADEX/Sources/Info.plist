<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 표준 HTTPS만 사용 → 수출 규정 문서 불필요 (TestFlight 업로드 시 매번 묻지 않게) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 잠금화면·다이내믹 아일랜드 포지션 표시 -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- 위젯을 누르면 해당 코인 화면으로: tradex://coin/KRW-BTC -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>tradex</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tradex</string>
			</array>
		</dict>
	</array>
	<!-- 랭킹 서버 (빌드 시 GitHub Secrets에서 주입, 공개 anon 키) -->
	<key>SupabaseProjectRef</key>
	<string>$(SUPABASE_PROJECT_REF)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<!-- 시작 화면: 가운데 TRADEX 로고 (라이트 흰 바탕/검정 로고, 다크 검정 바탕/흰 로고) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
